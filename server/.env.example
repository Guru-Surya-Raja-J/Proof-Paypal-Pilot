# Copy to server/.env and fill in. Never commit real values.

PORT=4000
NODE_ENV=development
# Public https URL of this server (used to register the PayPal webhook)
PUBLIC_URL=

# Merchant console login (single merchant demo account)
DEMO_EMAIL=merchant@proofpilot.local
DEMO_PASSWORD=change-me-before-demo

# Store identity shown on the storefront and in dispute responses
MERCHANT_NAME=Shikimori Handmade Goods
MERCHANT_SUPPORT_EMAIL=support@shikimorihandmade.example
MERCHANT_SHIP_FROM=Austin, TX, US

# PayPal REST (sandbox). Leave empty to run with clearly labelled simulated checkout.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Set after registering the webhook in Settings (required to accept webhook events)
PAYPAL_WEBHOOK_ID=
# Poll the Disputes API every N seconds (0 disables polling)
DISPUTE_POLL_SECONDS=120
# Set to "mock" to ignore credentials and force simulation
PAYPAL_MODE=

# AI provider. Gemini is used when GEMINI_API_KEY is set, Claude when ANTHROPIC_API_KEY is set.
# Leave both empty to use the deterministic rules engine (labelled in the UI).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional: force "gemini" or "claude" when both keys are set
AI_PROVIDER=
# AI calls are queued and spaced to stay under this limit (free-tier Gemini: 5)
AI_REQUESTS_PER_MINUTE=

# Storage: MongoDB when set, otherwise a JSON snapshot under DATA_DIR (default ../.data)
MONGODB_URI=
DATA_DIR=
